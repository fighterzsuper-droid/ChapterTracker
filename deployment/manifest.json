{
  "project": "ACCA FR/F7 Practice Portal",
  "owner": "Jayakiran",
  "startup": "app.py",
  "environment": "Bot-Hosting Python with HTTPS",
  "runtime_files": [
    "app.py",
    "requirements.txt",
    "fr_portal_v7.gz.part0",
    "fr_portal_v7.gz.part1",
    "fr_portal_v7.gz.part2",
    "fr_portal_v7.gz.part3"
  ],
  "persistent_private_files": [
    ".env",
    "f7_portal.db",
    "f7_portal.db.legacy-purged"
  ],
  "required_environment": [
    "FLASK_SECRET_KEY",
    "F7_DB_PATH",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "GOOGLE_REDIRECT_URI"
  ],
  "legacy_data_policy": "F8/F6 data is intentionally purged on first F7-only startup at the owner's request."
}
